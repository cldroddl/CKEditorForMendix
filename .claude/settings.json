{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/jshint-changed.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Linting widget JS with jshint..."
          }
        ]
      }
    ]
  }
}

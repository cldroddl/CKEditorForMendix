node_modules/
dist/
coverage/
*.mpk
.turbo/
*.tsbuildinfo

# Playwright
/playwright/.cache/
/test-results/
/playwright-report/
/blob-report/

# Local Mendix test projects (packages/*/config.projectPath).
# tests/testProject is committed as a real Mendix test app — its own
# tests/testProject/.gitignore applies the standard Mendix excludes, and the
# rules below re-include it (and its .mpk widgets) past the patterns above.
# Any other tests/* dir (e.g. a throwaway myTestProject) stays untracked.
/tests/*
!/tests/testProject/
!/tests/testProject/**
# Test suites (source is committed; their run artifacts are covered above).
!/tests/tsconfig.json
!/tests/ct/
!/tests/ct/**
!/tests/e2e/
!/tests/e2e/**

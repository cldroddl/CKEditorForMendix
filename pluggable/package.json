{
    "name": "ckeditor4formendix-workspace",
    "version": "1.2.0",
    "private": true,
    "description": "React + CKEditor 4 rewrite of the CKEditor for Mendix Dojo widgets",
    "license": "Apache-2.0",
    "workspaces": [
        "packages/shared",
        "packages/ckeditor4-for-mendix",
        "packages/ckeditor4viewer-for-mendix"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "dev:editor": "npm run start --workspace @ckeditor4formendix/editor",
        "dev:viewer": "npm run start --workspace @ckeditor4formendix/viewer",
        "release": "npm run release --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test:ct": "playwright test --config playwright-ct.config.ts",
        "test:e2e": "playwright test --config playwright.config.ts",
        "pretest:ct": "npm run build"
    },
    "devDependencies": {
        "@playwright/experimental-ct-react": "^1.62.1",
        "@playwright/test": "^1.62.1"
    }
}
